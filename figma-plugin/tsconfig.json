{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["@figma/plugin-typings"],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true
  },
  "include": ["code.ts", "tokens.ts", "variable-codec.ts", "placement.ts"],
  "exclude": ["node_modules", "code.js"]
}
